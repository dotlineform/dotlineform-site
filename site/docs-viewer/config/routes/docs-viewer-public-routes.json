{
  "schema_version": "docs_viewer_route_config_registry_v1",
  "routes": [
    {
      "schema_version": "docs_viewer_route_config_v5",
      "app_kind": "public",
      "route_id": "analysis",
      "route_path": "/",
      "viewer_base_url": "/",
      "features": [
        "workspace-configuration",
        "search",
        "recent",
        "reports"
      ],
      "access": {
        "management_ui": false
      },
      "services": {
        "generated_data": {
          "base_url": ""
        },
        "source": {
          "base_url": ""
        },
        "management": {
          "base_url": ""
        }
      },
      "docs_paths": {
        "index_tree_url": "/assets/data/docs/index-tree.json",
        "recent_url": "/assets/data/docs/recent.json",
        "search_index_url": "/assets/data/search/analysis/index.json"
      },
      "catalogue_paths": {
        "gallery_records_base_url": "/assets/data/catalogue/galleries/index/",
        "media_config_url": "/assets/data/catalogue/media-config.json",
        "work_thumbnails_base_url": "/assets/data/catalogue/works/thumbs/"
      },
      "config_urls": {
        "docs_viewer": "/docs-viewer/config/defaults/docs-viewer-public-config.json",
        "report_registry": "/assets/data/docs/public-reports.json"
      },
      "panels": {
        "index": {
          "enabled": true
        },
        "main": {
          "enabled": true,
          "default_view": "rendered-document"
        },
        "info": {
          "enabled": true,
          "default_view": "related-links"
        }
      }
    }
  ]
}
