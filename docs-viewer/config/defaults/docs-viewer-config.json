{
  "schema_version": "docs_viewer_config_v4",
  "docs_viewer": {
    "recent_limit": 20
  },
  "public_viewer_base_url": "/analysis/",
  "workspace": {
    "viewer_base_url": "/docs/",
    "default_doc_id": "d-20260426-164043-e14f49",
    "media": {
      "files": {
        "reference_prefix": "docs/files",
        "served_path_prefix": "/docs/assets/media/workspace/files"
      },
      "html": {
        "reference_prefix": "docs/html",
        "served_path_prefix": "/docs/assets/media/workspace/html"
      },
      "img": {
        "reference_prefix": "docs/img",
        "served_path_prefix": "/docs/assets/media/workspace/img"
      },
      "svg": {
        "reference_prefix": "docs/svg",
        "served_path_prefix": "/docs/assets/media/workspace/svg"
      }
    },
    "index_tree_url": "/docs/index-tree",
    "recent_url": "/docs/recent",
    "selected_url": "/docs/selected",
    "search_index_url": "/docs/search",
    "search": {
      "domain": "docs_viewer",
      "schema": "docs_viewer_search_index_v4",
      "index_url": "/docs/search",
      "rebuild_policy": "whole_index"
    },
    "collections": [
      {
        "collection": "works",
        "title": "Context",
        "manifest_url": "/docs/generated/external/works/manage-manifest.json",
        "by_id_url_base": "/docs/generated/external/works/by-id",
        "collection_customisation": {
          "id": "working_works",
          "capabilities": {
            "assignable_field_groups": [
              "authoring_subject"
            ]
          }
        }
      },
      {
        "collection": "concepts",
        "title": "Concepts",
        "manifest_url": "/docs/generated/external/concepts/manage-manifest.json",
        "by_id_url_base": "/docs/generated/external/concepts/by-id"
      },
      {
        "collection": "processing",
        "title": "Processing",
        "manifest_url": "/docs/generated/external/processing/manage-manifest.json",
        "by_id_url_base": "/docs/generated/external/processing/by-id",
        "collection_customisation": {
          "id": "working_processing",
          "capabilities": {
            "assignable_field_groups": [
              "authoring_subject"
            ]
          }
        }
      },
      {
        "collection": "moments",
        "title": "Moments",
        "manifest_url": "/docs/generated/external/moments/manage-manifest.json",
        "by_id_url_base": "/docs/generated/external/moments/by-id"
      },
      {
        "collection": "catalogue",
        "title": "catalogue",
        "manifest_url": "/docs/generated/external/catalogue/manage-manifest.json",
        "by_id_url_base": "/docs/generated/external/catalogue/by-id"
      }
    ],
    "links_enabled": true,
    "backlinks_url": "/docs/backlinks"
  }
}
