#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
TOOL_DIR="$ROOT_DIR/docs-viewer/tooling/lint"
RUFF_BIN="$TOOL_DIR/.venv/bin/ruff"

if [ "$#" -eq 0 ]; then
  echo "Usage: docs-viewer/bin/lint-python <path> [path ...]" >&2
  echo "Pass the exact new or materially changed Python paths to lint." >&2
  exit 2
fi

if [ ! -x "$RUFF_BIN" ]; then
  echo "Docs Viewer Ruff is not installed. Install docs-viewer/tooling/lint/python-requirements.txt into $TOOL_DIR/.venv." >&2
  exit 2
fi

cd "$ROOT_DIR"
exec "$RUFF_BIN" check --config "$TOOL_DIR/ruff.toml" "$@"
