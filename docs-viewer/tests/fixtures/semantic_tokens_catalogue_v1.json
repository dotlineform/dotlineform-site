{
  "schema_version": "docs_semantic_tokens_catalogue_contract_fixtures_v1",
  "grammar": {
    "opening_delimiter": "[[",
    "closing_delimiter": "]]",
    "identity_separator": ":",
    "title_separator": "|",
    "escape_character": "\\",
    "lexical_key_pattern": "^[a-z][a-z0-9-]*$",
    "lexical_id_pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
    "title": {
      "required": true,
      "single_line": true,
      "trim_before_serialization": true,
      "escaped_characters": {
        "\\": "\\\\",
        "|": "\\|",
        "]": "\\]"
      },
      "unknown_escape_is_malformed": true
    },
    "source_range": "zero-based half-open [start, end)",
    "collapsed_caret_activation": "start < caret < end",
    "inactive_contexts": [
      "inline_code",
      "fenced_code",
      "html_comment"
    ]
  },
  "catalogue_definition": {
    "schema_version": "docs_semantic_token_family_definition_v1",
    "key": "catalogue",
    "labels": {
      "family": "Catalogue",
      "source_action": "Add catalogue token",
      "info_view": "Catalogue token"
    },
    "occurrence_fields": [
      {
        "key": "title",
        "label": "Title",
        "required": true,
        "editable": true,
        "control": "text"
      }
    ],
    "ui_contributions": {
      "source_action": "source-add-catalogue-token",
      "modal": "catalogue-token-add-modal",
      "info_view": "catalogue-token-info"
    },
    "target_types": [
      {
        "key": "work",
        "label": "Work",
        "id_policy": {
          "normalizer": "digits_left_pad",
          "width": 5,
          "input_pattern": "^\\d{1,5}$",
          "canonical_pattern": "^\\d{5}$"
        },
        "lookup_adapter": "catalogue-work-target-lookup",
        "lookup_fields": [
          "title",
          "href",
          "meta",
          "image",
          "has_details"
        ]
      },
      {
        "key": "series",
        "label": "Series",
        "id_policy": {
          "normalizer": "series_id_or_slug",
          "input_pattern": "^[a-z0-9][a-z0-9-]*$",
          "canonical_pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "lookup_adapter": "catalogue-series-target-lookup",
        "lookup_fields": [
          "title",
          "href",
          "meta",
          "image"
        ]
      }
    ]
  },
  "json_shapes": {
    "target_lookup": {
      "schema_version": "docs_semantic_token_target_lookup_v2",
