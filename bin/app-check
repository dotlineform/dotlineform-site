#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

PROJECT="app/dotlineform.xcodeproj"
SCHEME="dotlineform"
DERIVED_DATA="var/app/DerivedData"
SIGNED_MAC=false

usage() {
  echo "Usage: bin/app-check [--signed-mac]"
  echo
  echo "Runs the retained unsigned Mac tests and generic-iPad test build."
  echo "--signed-mac also builds the Mac app with local signing and verifies its signature and required entitlements."
}

case "${1:-}" in
  "")
    ;;
  --signed-mac)
    SIGNED_MAC=true
    ;;
  --help|-h)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

if [ "$#" -gt 1 ]; then
  usage >&2
  exit 2
fi

echo "Running native Mac Swift tests"
xcodebuild \
  -project "$PROJECT" \
  -scheme "$SCHEME" \
  -configuration Debug \
  -destination 'platform=macOS' \
  -derivedDataPath "$DERIVED_DATA" \
  CODE_SIGNING_ALLOWED=NO \
  test

echo "Building the generic-iPad app and test bundle"
xcodebuild \
  -project "$PROJECT" \
  -scheme "$SCHEME" \
  -configuration Debug \
  -destination 'generic/platform=iOS' \
  -derivedDataPath "$DERIVED_DATA" \
  CODE_SIGNING_ALLOWED=NO \
  build-for-testing

if [ "$SIGNED_MAC" = false ]; then
  exit 0
fi

echo "Building and verifying the locally signed Mac app"
xcodebuild \
  -project "$PROJECT" \
  -scheme "$SCHEME" \
  -configuration Debug \
  -destination 'platform=macOS' \
  -derivedDataPath "$DERIVED_DATA" \
  build

APP_PATH="$DERIVED_DATA/Build/Products/Debug/dotlineform.app"
codesign --verify --deep --strict --verbose=2 "$APP_PATH"

ENTITLEMENTS_FILE="$(mktemp "${TMPDIR:-/tmp}/dotlineform-entitlements.XXXXXX")"
trap 'rm -f "$ENTITLEMENTS_FILE"' EXIT
codesign -d --entitlements - --xml "$APP_PATH" > "$ENTITLEMENTS_FILE"

for entitlement in \
  com.apple.security.app-sandbox \
  com.apple.security.files.user-selected.read-only \
  com.apple.security.network.client
do
  value="$(/usr/libexec/PlistBuddy -c "Print :$entitlement" "$ENTITLEMENTS_FILE")"
  if [ "$value" != true ]; then
    echo "Required Mac entitlement is not enabled: $entitlement" >&2
    exit 1
  fi
done

echo "The signed Mac app contains the required sandbox capabilities"
