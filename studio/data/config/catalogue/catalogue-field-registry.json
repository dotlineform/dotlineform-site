{
  "schema": "catalogue_field_registry_v1",
  "status": "active",
  "last_updated": "2026-09-01",
  "source_doc": "/docs/?scope=studio&doc=data-models-catalogue-source",
  "inventory_doc": "/docs/?scope=studio&doc=catalogue-field-registry-review",
  "description": "Field-to-artifact dependency registry for canonical Catalogue source edits and their Studio and public projections.",
  "artifact_families": {
    "source-json": "Canonical Studio catalogue source JSON.",
    "studio-lookup": "Studio read payloads and search/open payloads under studio/data/generated/catalogue-lookup/.",
    "work-json": "Focused public work JSON.",
    "series-json": "Focused public series JSON.",
    "series-index-json": "Aggregate public series index JSON.",
    "recent-index-json": "Public recent-publications index.",
    "catalogue-search": "Public catalogue search index.",
    "local-media": "Local media staging, derivative generation, and public thumbnail copy outputs."
  },
  "rule_statuses": {
    "current": "Artifacts selected or refreshed by the current broad planner, current lookup invalidation, or current media workflow.",
    "target": "Artifacts that should be selected by field-aware planning after Tasks 3-6."
  },
  "defaults": {
    "unknown_field": {
      "target": {
        "fallback": true,
        "artifacts_by_record_family": {
          "work": [
            "source-json",
            "studio-lookup",
            "work-json",
            "series-json",
            "series-index-json",
            "recent-index-json",
            "catalogue-search",
            "local-media"
          ],
          "work_detail": [
            "source-json",
            "studio-lookup",
            "work-json",
            "catalogue-search",
            "local-media"
          ],
          "series": [
            "source-json",
            "studio-lookup",
            "series-json",
            "series-index-json",
            "recent-index-json",
            "catalogue-search"
          ]
        },
        "reason": "Unknown source fields use conservative fallback until explicitly classified."
      }
    },
    "mixed_dependency_classes": {
      "target": {
        "fallback": true,
        "artifacts_by_record_family": {
          "work": [
            "source-json",
            "studio-lookup",
            "work-json",
            "series-json",
            "series-index-json",
            "recent-index-json",
            "catalogue-search",
            "local-media"
          ],
          "work_detail": [
            "source-json",
            "studio-lookup",
            "work-json",
            "catalogue-search",
            "local-media"
          ],
          "series": [
            "source-json",
            "studio-lookup",
            "series-json",
            "series-index-json",
            "recent-index-json",
            "catalogue-search"
          ]
        },
        "reason": "Mixed edits spanning dependency classes use conservative fallback until the planner can combine field rules safely."
      }
    }
  },
  "rules": [
    {
      "id": "work_identity",
      "record_family": "work",
      "operation": "create_delete_identity",
      "fields": [
        "work_id"
      ],
      "current": {
        "artifacts": [
          "source-json",
          "studio-lookup",
          "work-json",
          "series-json",
          "series-index-json",
          "recent-index-json",
          "catalogue-search",
          "local-media"
        ],
        "fallback": true
      },
      "target": {
        "artifacts": [
          "source-json",
          "studio-lookup",
          "work-json",
          "series-json",
          "series-index-json",
          "recent-index-json",
          "catalogue-search",
          "local-media"
        ],
        "fallback": false,
        "reason": "Work identity controls exact payload creation/removal, related Series member projections, lean Series membership facts, search identity, and media output names."
      }
    },
    {
      "id": "work_publish_membership",
      "record_family": "work",
      "operation": "metadata_update",
      "fields": [
        "status",
        "published_date",
        "series_ids"
      ],
      "current": {
        "artifacts": [
          "source-json",
          "studio-lookup",
          "work-json",
          "series-json",
          "series-index-json",
          "recent-index-json",
          "catalogue-search"
        ],
        "fallback": false
      },
      "target": {
        "artifacts": [
          "source-json",
          "studio-lookup",
          "work-json",
          "series-json",
          "series-index-json",
          "recent-index-json",
          "catalogue-search"
        ],
        "conditional_artifacts": [
          {
            "artifact": "series-index-json",
            "when": "old or new related series membership, ordering, or published visibility changes"
          }
        ],
        "fallback": false,
        "reason": "Publication state and membership affect exact Work inclusion, related exact Series members, lean Series membership facts, /recent/, and search."
      }
    },
    {
      "id": "work_display_core",
      "record_family": "work",
      "operation": "metadata_update",
      "fields": [
        "title",
        "year",
        "year_display"
      ],
      "current": {
        "artifacts": [
          "source-json",
          "studio-lookup",
          "work-json",
          "series-json",
          "series-index-json",
          "recent-index-json",
          "catalogue-search"
        ],
        "fallback": false
      },
      "target": {
        "artifacts": [
          "source-json",
          "studio-lookup",
          "work-json",
          "series-json",
          "recent-index-json",
          "catalogue-search"
        ],
        "fallback": false,
        "reason": "Core display fields are serialized to focused Work JSON, related exact Series member rows, /recent/ entries, and Catalogue Search."
      }
    },
    {
      "id": "work_search_enrichment",
      "record_family": "work",
      "operation": "metadata_update",
      "fields": [
        "medium_type",
        "medium_caption"
      ],
      "current": {
        "artifacts": [
          "source-json",
          "studio-lookup",
          "work-json",
          "series-json",
          "series-index-json",
          "recent-index-json",
          "catalogue-search"
        ],
        "fallback": false
      },
      "target": {
        "artifacts": [
          "source-json",
          "studio-lookup",
          "work-json",
          "catalogue-search"
        ],
        "fallback": false,
        "reason": "Medium fields enrich focused work metadata and catalogue search, but do not affect series membership or aggregate work cards."
      }
    },
    {
      "id": "work_local_public_metadata",
      "record_family": "work",
      "operation": "metadata_update",
      "fields": [
        "duration",
        "artist",
        "width_cm",
        "height_cm",
        "depth_cm",
        "downloads",
        "links"
      ],
      "current": {
        "artifacts": [
          "source-json",
          "studio-lookup",
          "work-json",
          "series-json",
          "series-index-json",
          "recent-index-json",
          "catalogue-search"
        ],
        "fallback": false
      },
      "target": {
        "artifacts": [
          "source-json",
          "studio-lookup",
          "work-json"
        ],
        "fallback": false,
        "reason": "These fields are focused work metadata and should not select series artifacts or broad aggregate indexes unless a future public artifact starts serializing them."
      }
    },
    {
      "id": "work_storage",
      "record_family": "work",
      "operation": "metadata_update",
      "fields": [
        "storage_location"
      ],
      "current": {
        "artifacts": [
          "source-json",
          "studio-lookup",
          "work-json",
          "series-json",
          "series-index-json",
          "recent-index-json",
          "catalogue-search"
        ],
        "fallback": false
      },
      "target": {
        "artifacts": [
          "source-json",
          "studio-lookup"
        ],
        "fallback": false,
        "reason": "Storage metadata remains in canonical source and the Studio lookup; the local Catalogue Works report reads canonical source through the Studio API."
      }
    },
    {
      "id": "work_media_source",
      "record_family": "work",
      "operation": "metadata_update",
      "fields": [
        "media_source_id",
        "project_folder",
        "project_subfolder",
        "project_filename"
      ],
      "current": {
        "artifacts": [
          "source-json",
          "studio-lookup",
          "work-json",
          "series-json",
          "series-index-json",
          "recent-index-json",
          "catalogue-search",
          "local-media"
        ],
        "fallback": false
      },
      "target": {
        "artifacts": [
          "source-json",
          "studio-lookup",
          "local-media"
        ],
        "conditional_artifacts": [
          {
            "artifact": "work-json",
            "when": "media refresh changes derived width_px or height_px"
          }
        ],
        "fallback": false,
        "reason": "Work source media folder and filename fields control Studio source-image editing, media readiness, and derivative generation; JSON rebuild follows only if derived dimensions change."
      }
    },
    {
      "id": "work_derived_image_dimensions",
      "record_family": "work",
      "operation": "derived_update",
      "fields": [
        "width_px",
        "height_px"
      ],
      "current": {
        "artifacts": [
          "source-json",
          "studio-lookup",
          "work-json",
          "series-json",
          "series-index-json",
          "recent-index-json",
          "catalogue-search"
        ],
        "fallback": false
      },
      "target": {
        "artifacts": [
          "source-json",
          "studio-lookup",
          "work-json"
        ],
        "fallback": false,
        "reason": "Pixel dimensions are derived from image files and affect focused work image aspect ratio."
      }
    },
    {
      "id": "work_editor_only",
      "record_family": "work",
      "operation": "metadata_update",
      "fields": [
        "provenance"
      ],
      "current": {
        "artifacts": [
          "source-json",
          "studio-lookup"
        ],
        "fallback": false
      },
      "target": {
        "artifacts": [
          "source-json",
          "studio-lookup"
        ],
        "fallback": false,
        "reason": "These fields are Studio/editor-only and are not published to public runtime artifacts."
      }
    },
    {
      "id": "work_media_version",
      "record_family": "work",
      "operation": "derived_update",
      "fields": [
        "media_version"
      ],
      "current": {
        "artifacts": [
          "source-json",
          "studio-lookup",
          "work-json"
        ],
        "fallback": false
      },
      "target": {
        "artifacts": [
          "source-json",
          "studio-lookup",
          "work-json"
        ],
        "fallback": false,
        "reason": "The confirmed work primary-media version is publisher-owned and affects the focused Studio lookup and public work payload only."
