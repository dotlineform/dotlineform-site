{
  "schema": "catalogue_field_registry_v2",
  "status": "active",
  "last_updated": "2026-09-05",
  "description": "Current source fields and output ownership. Save completes the affected Catalogue output; no field fallback or record publication planner.",
  "artifact_families": {
    "source-json": "Canonical Studio Catalogue records.",
    "studio-lookup": "Private editor read projections.",
    "work-json": "catalogue/generated/works/index/<work_id>.json, including ordered Detail sections.",
    "series-json": "catalogue/generated/series/index/<series_id>.json and ordered members.",
    "catalogue-indexes": "Compact Work, Series and Detail indexes beneath catalogue/generated.",
    "local-media": "Configured media-staging inputs/primary derivatives and generated Work/Detail thumbs.",
    "remote-media": "Active Work/Detail primary variants and downloads; the archive is excluded."
  },
  "rules": [
    {
      "id": "work",
      "record_family": "work",
      "operation": "save_create_delete",
      "fields": [
        "work_id",
        "series_id",
        "media_source_id",
        "project_folder",
        "project_subfolder",
        "project_filename",
        "media_version",
        "title",
        "width_cm",
        "height_cm",
        "year",
        "year_display",
        "medium_type",
        "medium_caption",
        "storage_location",
        "duration",
        "depth_cm",
        "width_px",
        "height_px",
        "provenance",
        "artist",
        "downloads",
        "links"
      ],
      "artifacts": [
        "source-json",
        "studio-lookup",
        "work-json",
        "series-json",
        "catalogue-indexes",
        "local-media",
        "remote-media"
      ],
      "reason": "Refresh the exact Work and its Details, both former and current Series membership, indexes and required media. Private metadata stays in Studio."
    },
    {
      "id": "series",
      "record_family": "series",
      "operation": "save_create_delete",
      "fields": [
        "series_id",
        "title",
        "year",
        "year_display",
        "sort_fields"
      ],
      "artifacts": [
        "source-json",
        "studio-lookup",
        "series-json",
        "catalogue-indexes"
      ],
      "reason": "Refresh this Series and ordered members. Explicit membership changes also refresh the affected Works through their ordinary owner."
    },
    {
      "id": "work_detail",
      "record_family": "work_detail",
      "operation": "save_create_delete",
      "fields": [
        "detail_uid",
        "work_id",
        "detail_id",
        "section_id",
        "project_filename",
        "media_version",
        "title",
        "width_px",
        "height_px"
      ],
      "artifacts": [
        "source-json",
        "studio-lookup",
        "work-json",
        "catalogue-indexes",
        "local-media",
        "remote-media"
      ],
      "reason": "Refresh the owning Work aggregate and exact Detail media; Detail identity remains composite."
    },
    {
      "id": "work_detail_section",
      "record_family": "work_detail_section",
      "operation": "save_create_delete",
      "fields": [
        "section_id",
        "work_id",
        "details_subfolder",
        "section_title",
        "section_order",
        "detail_sort"
      ],
      "artifacts": [
        "source-json",
        "studio-lookup",
        "work-json",
        "catalogue-indexes",
        "local-media",
        "remote-media"
      ],
      "reason": "Refresh section ordering and the owning Work. A source-folder change refreshes its exact Detail media."
    }
  ]
}
