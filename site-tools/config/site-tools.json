{
  "schema_version": "site_tools_config_v1",
  "site": {
    "title": "dotlineform",
    "url": "https://www.dotlineform.com",
    "baseurl": "",
    "live_url": "https://www.dotlineform.com",
    "timezone": "Europe/London"
  },
  "media": {
    "base": "https://media.dotlineform.com",
    "image_works": "/works/img",
    "files_works": "/works/files"
  },
  "thumbs": {
    "base": "",
    "works": "/assets/works/img"
  },
  "home_media": {
    "base": "https://media.dotlineform.com",
    "prefix": "/home/img"
  },
  "docs_viewer": {
    "route_config_url": "/docs-viewer/config/routes/docs-viewer-public-routes.json",
    "entrypoint": "/docs-viewer/runtime/js/public/docs-viewer-public.js",
    "stylesheet": "/docs-viewer/static/css/docs-viewer.css"
  },
  "validation": {
    "site_root": "site",
    "required_files": [
      ".nojekyll",
      "index.html",
      "CNAME",
      "favicon.ico",
      "favicon-16x16.png",
      "favicon-32x32.png",
      "apple-touch-icon.png",
      "apple-touch-icon-precomposed.png",
      "android-chrome-192x192.png",
      "android-chrome-512x512.png",
      "safari-pinned-tab.svg",
      "site.webmanifest",
      "assets/css/error.css",
      "assets/data/docs/index-tree.json",
      "assets/data/search/analysis/index.json",
      "docs-viewer/config/defaults/docs-viewer-public-config.json",
      "docs-viewer/config/routes/docs-viewer-public-routes.json",
      "docs-viewer/static/css/docs-viewer.css",
      "docs-viewer/runtime/js/public/docs-viewer-public.js",
      "docs-viewer/runtime/js/shared/docs-viewer-app-boot.js",
      "docs-viewer/runtime/js/shared/docs-viewer-related-links.js",
      "404.html"
    ],
    "required_directories": [
      "assets/data/docs/by-id",
      "docs-viewer/runtime/js/public",
      "docs-viewer/runtime/js/shared"
    ]
  }
}
